<Window x:Class="MyNet.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyNet.UI"
        Title="MyNet — Network Controller"
        Icon="icon.ico"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBgDeep}">

    <Window.DataContext>
        <local:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Title bar -->
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Main content -->
            <RowDefinition Height="250"/>   <!-- Expanded Log panel -->
            <RowDefinition Height="Auto"/>  <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ============================================================
             TITLE BAR
        ============================================================ -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo / Title -->
                    <TextBlock FontSize="18" FontWeight="Bold" VerticalAlignment="Center">
                        <Run Foreground="{StaticResource BrushAccentCyan}" Text="&#x25A0; "/>
                        <Run Foreground="{StaticResource BrushTextPrimary}" Text="MyNet"/>
                    </TextBlock>
                    <TextBlock Text="  |  Network Bandwidth Controller"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="&#x26A0; USE ON YOUR OWN NETWORK ONLY"
                           Foreground="{StaticResource BrushAccentOrange}"
                           FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ============================================================
             TOOLBAR
        ============================================================ -->
        <Border Grid.Row="1"
                Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Adapter selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="ADAPTER:" Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="280"
                              ItemsSource="{Binding Adapters}"
                              SelectedItem="{Binding SelectedAdapter}"
                              DisplayMemberPath="FriendlyName"/>
                </StackPanel>

                <!-- Scan buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SuccessButton}"
                            Content="&#x25B6; SCAN NETWORK"
                            IsEnabled="{Binding CanScan}"
                            Click="BtnScan_Click"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource InfoButton}"
                            Content="&#x2637; SCAN VULNS"
                            Click="BtnScanVulns_Click"
                            Margin="0,0,8,0"
                            ToolTip="Check discovered devices for common mobile CVEs and risk scores."/>
                    <Button Style="{StaticResource DangerButton}"
                            Content="&#x25A0; STOP"
                            IsEnabled="{Binding IsScanning}"
                            Click="BtnStopScan_Click"
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BaseButton}"
                            Content="&#x2692; DIAGNOSTICS"
                            Click="BtnDiagnostics_Click"
                            ToolTip="Run network health tests to debug exactly why internet failed."
                            Margin="0,0,8,0"/>
                    <Button Style="{StaticResource BaseButton}"
                            Content="&#x21BA; RESTORE ALL"
                            Click="BtnRestoreAll_Click"
                            ToolTip="Remove all blocks/limits and restore ARP caches"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================
             MAIN CONTENT  (left: device list  |  right: device controls)
        ============================================================ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- ─── Left: Device Table ─── -->
            <Border Grid.Column="0"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section header -->
                    <Border Grid.Row="0" Background="{StaticResource BrushBgDeep}"
                            Padding="12,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Foreground="{StaticResource BrushAccentCyan}" Text="DEVICES  "/>
                            <TextBlock Foreground="{StaticResource BrushTextSecondary}" FontSize="11"
                                       Text="{Binding Devices.Count, StringFormat='({0} found)'}" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </Border>

                    <!-- Device DataGrid -->
                    <DataGrid Grid.Row="1"
                              x:Name="DeviceGrid"
                              ItemsSource="{Binding Devices}"
                              SelectedItem="{Binding SelectedDevice}"
                              SelectionChanged="DeviceGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP ADDRESS"   Binding="{Binding IpAddress}"   Width="130"/>
                            <DataGridTextColumn Header="NAME"         Binding="{Binding DeviceName}"  Width="140"/>
                            <DataGridTextColumn Header="OS"           Binding="{Binding OperatingSystem}" Width="100"/>
                            <DataGridTextColumn Header="SERVICES"     Binding="{Binding Services}" Width="120"/>
                            <DataGridTextColumn Header="DETAILS"      Binding="{Binding ScanDetails}" Width="150"/>
                            <DataGridTextColumn Header="VULNERABILITIES" Binding="{Binding Vulnerabilities}" Width="180"/>
                            <DataGridTextColumn Header="RISK"         Binding="{Binding RiskScore, StringFormat='\{0:F1\}'}" Width="60"/>
                            <DataGridTemplateColumn Header="ACTIONS" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="INJECT" 
                                                Style="{StaticResource InfoButton}" 
                                                FontSize="9" Padding="4,1" 
                                                Click="BtnInject_Click"
                                                ToolTip="Send a harmless UDP probe to test remediation."/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ACTIVITY (LIVE)" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="VENDOR"       Binding="{Binding Vendor}"      Width="120"/>
                            <DataGridTemplateColumn Header="STATUS"   Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushAccentGreen}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushAccentRed}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="↑ LIMIT"     Binding="{Binding UploadLimitText}"   Width="90"/>
                            <DataGridTextColumn Header="↓ LIMIT"     Binding="{Binding DownloadLimitText}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ─── Splitter ─── -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BrushBorder}"/>

            <!-- ─── Right: Device Controls Panel ─── -->
            <Border Grid.Column="2"
                    Background="{StaticResource BrushBgPanel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Panel header -->
                    <Border Grid.Row="0" Background="{StaticResource BrushBgDeep}"
                            Padding="12,6" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                        <TextBlock Foreground="{StaticResource BrushAccentCyan}" Text="DEVICE CONTROLS"/>
                    </Border>

                    <!-- Controls (visible only when a device is selected) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16" IsEnabled="{Binding CanControl}">

                            <!-- Selected device info -->
                            <Border Background="{StaticResource BrushBgCard}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1" CornerRadius="3" Padding="12" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="SELECTED DEVICE" FontSize="10"
                                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="TxtSelectedIp"
                                               FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource BrushAccentCyan}"
                                               Text="—"/>
                                    <TextBlock x:Name="TxtSelectedMac"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               Text="—"/>
                                    <TextBlock x:Name="TxtSelectedHost"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushTextSecondary}"
                                               Text="—"/>
                                </StackPanel>
                            </Border>

                            <!-- Block toggle -->
                            <TextBlock Text="ACCESS CONTROL" FontSize="10"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                            
                            <CheckBox x:Name="CheckGhostMode" Content="GHOST MODE (Silent Shadowing)" 
                                      IsChecked="True" Foreground="{StaticResource BrushAccentCyan}"
                                      FontSize="11" Margin="0,0,0,10" Checked="CheckGhostMode_Changed" Unchecked="CheckGhostMode_Changed"
                                      ToolTip="When ON, devices have internet but are monitored. When OFF, devices are blocked entirely."/>

                            <Button x:Name="BtnBlock"
                                    Style="{StaticResource DangerButton}"
                                    Content="&#x1F6AB; START BLOCKING / SHADOWING"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,16"
                                    Click="BtnBlock_Click"/>

                            <Button x:Name="BtnPhantomAlert"
                                    Style="{StaticResource InfoButton}"
                                    Content="&#x1F4F1; SEND SPY ALERT (Phantom)"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,16"
                                    Click="BtnPhantomAlert_Click"
                                    ToolTip="Triggers a native system popup on the target phone with a custom message."/>

                            <!-- Upload limit -->
                            <TextBlock Text="UPLOAD LIMIT (kbps)" FontSize="10"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SliderUpload"
                                        Minimum="0" Maximum="10000" Value="0"
                                        TickFrequency="500" IsSnapToTickEnabled="False"
                                        ValueChanged="SliderUpload_ValueChanged"/>
                                <TextBlock x:Name="TxtUploadVal" Grid.Column="1"
                                           Text="Unlimited" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushAccentCyan}"
                                           FontSize="11" Margin="8,0,0,0"/>
                            </Grid>

                            <!-- Download limit -->
                            <TextBlock Text="DOWNLOAD LIMIT (kbps)" FontSize="10"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,8,0,4"/>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SliderDownload"
                                        Minimum="0" Maximum="10000" Value="0"
                                        TickFrequency="500" IsSnapToTickEnabled="False"
                                        ValueChanged="SliderDownload_ValueChanged"/>
                                <TextBlock x:Name="TxtDownloadVal" Grid.Column="1"
                                           Text="Unlimited" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushAccentCyan}"
                                           FontSize="11" Margin="8,0,0,0"/>
                            </Grid>

                            <!-- Apply bandwidth -->
                            <Button Style="{StaticResource BaseButton}"
                                    Content="&#x2713; APPLY BANDWIDTH LIMIT"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,8"
                                    Click="BtnApplyBandwidth_Click"/>

                            <!-- Remove limit -->
                            <Button Style="{StaticResource BaseButton}"
                                    Content="&#x2715; REMOVE LIMITS"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,16"
                                    Click="BtnRemoveLimits_Click"/>

                            <Separator Background="{StaticResource BrushBorder}" Margin="0,0,0,16"/>

                            <!-- Stats section -->
                            <TextBlock Text="TRAFFIC STATS" FontSize="10"
                                       Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{StaticResource BrushBgCard}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="SENT" FontSize="9"
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                        <TextBlock x:Name="TxtBytesSent"
                                                   Text="0 B" FontSize="13"
                                                   Foreground="{StaticResource BrushAccentGreen}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="{StaticResource BrushBgCard}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1" CornerRadius="3" Padding="8" Margin="4,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="RECV" FontSize="9"
                                                   Foreground="{StaticResource BrushTextSecondary}"/>
                                        <TextBlock x:Name="TxtBytesRecv"
                                                   Text="0 B" FontSize="13"
                                                   Foreground="{StaticResource BrushAccentCyan}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Placeholder when no device selected -->
                            <TextBlock x:Name="TxtNoDevice"
                                       Text="&#x2190; Select a device from the list"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="12" TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,24,0,0"
                                       Visibility="Collapsed"/>
                            <Separator Background="{StaticResource BrushBorder}" Margin="0,16,0,16"/>
                            
                            <!-- Nomad Protocol section -->
                            <TextBlock Text="NOMAD PROTOCOL (SELF-BYPASS)" FontSize="10" 
                                       FontWeight="Bold" Foreground="{StaticResource BrushAccentCyan}" Margin="0,0,0,8"/>
                            <TextBlock Text="Bypass router-level filters by shifting your local identity." 
                                       TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,12"/>

                            <Button Name="BtnRotateIdentity" Content="ROTATE IDENTITY (MAC)" Click="BtnRotateIdentity_Click"
                                    Style="{StaticResource BaseButton}" Height="32" Margin="0,0,0,8"
                                    ToolTip="Randomizes your MAC address and cycles the NIC. The router will see you as a new device."/>

                            <Button Name="BtnLockdownDns" Content="LOCKDOWN DNS (1.1.1.1)" Click="BtnLockdownDns_Click"
                                    Style="{StaticResource BaseButton}" Height="32"
                                    ToolTip="Forces Cloudflare/Google DNS to bypass router hijacking."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================
             LOG PANEL
        ============================================================ -->
        <Border Grid.Row="3"
                Background="{StaticResource BrushBgDeep}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BrushBgPanel}"
                        Padding="12,4" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                    <TextBlock Text="LOG OUTPUT" Foreground="{StaticResource BrushAccentCyan}" FontSize="10"/>
                </Border>

                <ListBox Grid.Row="1"
                         x:Name="LogList"
                         ItemsSource="{Binding LogLines}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource BrushTextSecondary}"
                         FontFamily="Consolas" FontSize="11"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         Padding="8,4"/>
            </Grid>
        </Border>

        <!-- ============================================================
             STATUS BAR
        ============================================================ -->
        <Border Grid.Row="4"
                Background="{StaticResource BrushBgPanel}"
                BorderBrush="{StaticResource BrushBorder}"
                BorderThickness="0,1,0,0"
                Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Ellipse x:Name="ScanIndicator" Width="8" Height="8"
                             Fill="{StaticResource BrushTextSecondary}"
                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtScanStatus" Text="IDLE"
                               Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
